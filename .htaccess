# ==============================================================================
# CIC Alumni 1995 Set — Core Security Headers, GZIP & Browser Caching
# ==============================================================================

<IfModule mod_headers.c>
  # 1. Content Security Policy (CSP - Hardened)
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob:; connect-src 'self' https: wss:; frame-src 'self' https://checkout.paystack.com https://*.paystack.co https://*.flutterwave.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https:; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests;"

  # 2. Prevent Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # 3. Prevent MIME Sniffing
  Header always set X-Content-Type-Options "nosniff"

  # 4. Strict Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # 5. Restrict Unused Hardware & Browser Features
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self)"

  # 6. HTTP Strict Transport Security (HSTS - 1 Year)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # 7. Cross-Site Scripting Filter
  Header always set X-XSS-Protection "1; mode=block"

  # 8. Cross-Origin Policies
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# ==============================================================================
# GZIP & DEFLATE COMPRESSION (PageSpeed / Core Web Vitals Optimization)
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ==============================================================================
# BROWSER CACHING (PageSpeed / Core Web Vitals Optimization)
# ==============================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images & Fonts: 1 Year (Immutable)
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # CSS & JS: 7 Days
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"

  # HTML: Always revalidate
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Disable Directory Browsing
Options -Indexes

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.admin == true || 
         request.auth.token.role == 'superadmin' || 
         request.auth.token.role == 'financial_secretary');
    }

    // Projects: Public can read active projects; Only Admin can write
    match /projects/{projectId} {
      allow read: if resource.data.status != 'archived' || isAdmin();
      allow create, update, delete: if isAdmin();

      match /milestones/{milestoneId} {
        allow read: if true;
        allow write: if isAdmin();
      }

      match /donations/{donationId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Payments: Public can create pending/verified checkout records; Only Admin can view all or alter
    match /payments/{paymentId} {
      allow create: if request.resource.data.amount > 0 && 
                      request.resource.data.reference is string &&
                      request.resource.data.status in ['Pending', 'Successful'];
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Alumni Members Directory: Public read; Admin write
    match /members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Payment Categories & System Configuration: Public read; Admin write
    match /paymentCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs: Strictly Admin read; Write only via backend
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
